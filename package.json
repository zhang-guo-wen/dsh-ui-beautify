{
  "name": "@zhang-guo-wen/dsh-ui-beautify",
  "description": "Page beautification for DeepSeek Harness: serve a bundled Noto Sans SC webfont and switch the Web GUI body font to it",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "assets/fonts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/smoke.mjs && node tests/http.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-theme": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.6-alpha.2",
    "@types/node": "^26.5.0",
    "lightningcss": "^1.32.0",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
